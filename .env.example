# Optional: enable visual geolocation when a photo has no EXIF GPS.
# Preference if more than one is set: OPENAI_API_KEY → ANTHROPIC_API_KEY → GEMINI_API_KEY.
# Gemini free-tier keys work: https://aistudio.google.com/apikey
# On Vercel, add the same names in Project Settings → Environment Variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# OpenAI is called through the Responses API with reasoning effort "low";
# use a model that accepts image input.
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-3.6-flash
# PORT=5173
